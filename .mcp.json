{
  "mcpServers": {
        "atlassian": {
            "type": "http",
            "url": "https://mcp.atlassian.com/v1/mcp"
        },
        "linear-server": {
            "type": "http",
            "url": "https://mcp.linear.app/sse"
        },
        "codex": {
            "type": "stdio",
            "command": "codex",
            "args": ["mcp-server"]
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": ["@playwright/mcp@latest"]
        },
        "exa": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "exa-mcp-server", "--tools", "get_code_context_exa"],
            "env": {
                "EXA_API_KEY": "9da81e9b-a025-4cf9-891a-55db45d8b180"
            }
        }
    }
}